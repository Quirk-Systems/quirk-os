{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/one-to-infinity/run.schema.json",
  "title": "One-to-Infinity Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_type","schema_version","run_id","transformation_id","cycle_index","status","authority_scope","trigger","inputs","action_trace","outputs","observations","retained_state_updates","receipts","metrics","learning_updates"],
  "properties": {
    "contract_type": {"const": "one_to_infinity_run"},
    "schema_version": {"const": "0.1.0-candidate"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "transformation_id": {"type": "string", "pattern": "^oti-[a-z0-9-]+$"},
    "cycle_index": {"type": "integer", "minimum": 1},
    "status": {"enum": ["planned","running","completed","failed","aborted"]},
    "authority_scope": {"type": "object", "required": ["human_gate_required","provider_may_promote","may_modify_promotion_policy"], "properties": {"human_gate_required": {"const": true}, "provider_may_promote": {"const": false}, "may_modify_promotion_policy": {"const": false}}},
    "trigger": {"type": "string", "minLength": 3},
    "inputs": {"type": "array", "minItems": 1},
    "action_trace": {"type": "array", "minItems": 1},
    "outputs": {"type": "array", "minItems": 1},
    "observations": {"type": "array", "minItems": 1},
    "retained_state_updates": {"type": "array", "items": {"type": "object", "required": ["state_id","requires_promotion_decision"], "properties": {"state_id": {"type": "string", "pattern": "^state-[a-z0-9-]+$"}, "requires_promotion_decision": {"const": true}}}},
    "receipts": {"type": "array", "minItems": 1},
    "metrics": {"type": "object", "minProperties": 1},
    "learning_updates": {"type": "array", "items": {"type": "object", "required": ["learning_id","delay_handling","requires_human_authorization"], "properties": {"learning_id": {"type": "string", "minLength": 3}, "delay_handling": {"enum": ["delay_respected","insufficient_delay_marked_unknown"]}, "requires_human_authorization": {"const": true}}}}
  }
}
