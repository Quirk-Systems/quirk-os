{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One-to-Infinity transformation candidate contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "schema_version",
    "transformation_id",
    "status",
    "boundaries",
    "value_contract",
    "mechanism",
    "economics",
    "governance"
  ],
  "properties": {
    "contract_type": {
      "const": "one_to_infinity_transformation"
    },
    "schema_version": {
      "const": "0.2.0-candidate"
    },
    "transformation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate"
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "canon",
        "provider_access",
        "publication"
      ],
      "properties": {
        "runtime": {
          "const": false
        },
        "canon": {
          "const": false
        },
        "provider_access": {
          "const": false
        },
        "publication": {
          "const": false
        }
      }
    },
    "value_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beneficiary",
        "metric",
        "minimum_effect"
      ],
      "properties": {
        "beneficiary": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "minimum_effect": {
          "type": "number"
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "observable_output",
        "retained_state",
        "reinvestment",
        "constraints",
        "balancers",
        "delays"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "observable_output": {
          "type": "string",
          "minLength": 1
        },
        "retained_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_id",
            "from_output",
            "used_next_cycle"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "from_output": {
              "type": "string",
              "minLength": 1
            },
            "used_next_cycle": {
              "type": "boolean"
            }
          }
        },
        "reinvestment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_state_id",
            "target_next_input",
            "connected"
          ],
          "properties": {
            "source_state_id": {
              "type": "string",
              "minLength": 1
            },
            "target_next_input": {
              "type": "string",
              "minLength": 1
            },
            "connected": {
              "type": "boolean"
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "balancers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_minutes_per_outcome",
        "cost_per_outcome",
        "active_constraint"
      ],
      "properties": {
        "human_minutes_per_outcome": {
          "type": "number",
          "minimum": 0
        },
        "cost_per_outcome": {
          "type": "number",
          "minimum": 0
        },
        "active_constraint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_gate",
        "auto_promote"
      ],
      "properties": {
        "human_gate": {
          "const": true
        },
        "auto_promote": {
          "const": false
        }
      }
    }
  }
}
