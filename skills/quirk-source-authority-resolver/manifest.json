{
  "$schema": "../../schemas/skill-package.schema.json",
  "api_version": "quirk.dev/skill/v1alpha1",
  "kind": "SkillPackage",
  "id": "quirk-source-authority-resolver",
  "title": "Quirk Source Authority Resolver",
  "version": "0.2.1",
  "status": "candidate",
  "family": "research",
  "purpose": "Resolve source authority, provenance, supersession, drift, and conflict before any cross-platform read or proposed write.",
  "authority": {
    "ceiling": "infer",
    "capability_does_not_imply_authority": true,
    "requires_external_grant": true,
    "requires_independent_approval_for_active": true,
    "self_activation": false,
    "self_escalation": false,
    "canon_promotion": false,
    "irreversible_write": false
  },
  "triggers": {
    "when_to_use": [
      "Use when the task requires resolve source authority, provenance, supersession, drift, and conflict before any cross-platform read or proposed write."
    ],
    "when_not_to_use": [
      "Do not use when the requested decision scope or source identities cannot be established. Missing mutation authority is an unknown to report, not a bar to authorized read-only discovery.",
      "Do not use when a trigger collision with another skill remains unresolved."
    ],
    "routing_signals": [
      "canonical conflict",
      "source authority",
      "provenance",
      "supersession",
      "stale projection"
    ],
    "collision_behavior": "block"
  },
  "contract": {
    "inputs": [
      {
        "name": "sources",
        "type": "array",
        "required": true
      },
      {
        "name": "decision_scope",
        "type": "string",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "authority_census",
        "type": "object",
        "required": true
      },
      {
        "name": "proposed_moves",
        "type": "array",
        "required": false
      }
    ],
    "invariants": [
      "recency_is_not_authority",
      "vendor_identity_is_not_quirk_identity",
      "unresolved_conflict_remains_unresolved",
      "permission_and_delivery_are_separate",
      "old_head_proof_remains_historical",
      "projection_refresh_cannot_grant_authority"
    ],
    "failure_conditions": [
      "missing_source_identity",
      "contradictory_canonical_claims",
      "authority_inferred_from_convenience"
    ],
    "stop_conditions": [
      "missing_source_identity",
      "contradictory_canonical_claims",
      "authority_inferred_from_convenience",
      "authority_grant_missing",
      "self_promotion_attempt"
    ]
  },
  "method": {
    "moves": [
      "read_sources",
      "fingerprint_sources",
      "emit_authority_census",
      "emit_proposed_move"
    ],
    "sequence": [
      "Resolve purpose, source identities and decision scope; inspect explicit grants and supersession before any consequential action. Read-only discovery may report authority as unknown.",
      "Inventory required inputs and preserve provenance or source references.",
      "Execute the smallest deterministic procedure that can satisfy the declared output.",
      "Evaluate positive, adversarial, regression, and authority conditions.",
      "Emit an attributable receipt and route improvements as Proposed Moves."
    ],
    "decision_points": [
      "Is the source and decision authority sufficient for this procedure?",
      "Would the next action exceed the declared authority ceiling or become irreversible?",
      "Is the evidence strong enough to emit the declared output rather than abstain?"
    ],
    "approval_gates": [
      "External admission is required before runtime loading.",
      "A separate scoped grant is required for every consequential execution."
    ]
  },
  "resources": [
    {
      "resource_type": "source_pack",
      "access": "read",
      "required": true,
      "constraints": [
        "bounded_scope",
        "provenance_required"
      ]
    },
    {
      "resource_type": "evidence_ledger",
      "access": "reference",
      "required": true,
      "constraints": [
        "host_owned_append_only_write",
        "receipt_required",
        "no_status_promotion"
      ]
    }
  ],
  "tools": [
    {
      "name": "quirk_runtime",
      "actions": [
        "read_sources",
        "fingerprint_sources",
        "emit_authority_census",
        "emit_proposed_move"
      ],
      "required": true
    },
    {
      "name": "human_review",
      "actions": [
        "request_review",
        "attach_review_evidence"
      ],
      "required": false
    }
  ],
  "quality": {
    "eval_suite_ref": "evals/skills/conformance.json",
    "required_case_kinds": [
      "positive",
      "adversarial",
      "regression",
      "authority"
    ],
    "minimum_score": 1.0,
    "regression_required": true,
    "anti_patterns": [
      "newest_copy_wins",
      "projection_promoted_by_popularity",
      "invisible_bryan_context"
    ]
  },
  "learning": {
    "mutation_mode": "propose_only",
    "historical_rewrite": false,
    "promotion_requires_external_admission": true,
    "feedback_capture": "append_only_receipt"
  },
  "compatibility": {
    "mapping_ref": "mappings/skill-package.v1.yaml",
    "runtime_manifest_ref": "schemas/runtime-manifest.schema.json",
    "minimum_runtime_contract": "0.2.0"
  },
  "provenance": {
    "source_path": "skills/quirk-source-authority-resolver/SKILL.md",
    "derived_from": [
      "Quirk-Systems/quirk-os PR #5 candidate skill source",
      "Quirk procedural-intelligence hardening v0.2",
      "2026-09-11 refresh: Core issue #4; Applause issue #52; mixed-media PR #81 head drift"
    ],
    "steward": "Bryan",
    "created_at": "2026-08-12T04:00:00Z"
  },
  "integrity": {
    "source_algorithm": "git-blob-sha1",
    "source_blob_sha": "e81b7998157cdf096ea31b2be16bae537e6e7ca5",
    "manifest_algorithm": "sha256-canonical-json-v1",
    "manifest_sha256": "1be9a1744b9c3f8866a74bb7c2f06a27f61baf6903a502f59d007cad88cf40ab"
  }
}
