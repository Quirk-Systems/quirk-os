  "version": "0.2.0",
  "status": "candidate",
  "family": "evolve",
  "purpose": "Design bounded feedback control with trustworthy sensors, explicit targets, reversible actuators, constraints, recovery, simulation, and human authority.",
  "authority": {
    "ceiling": "propose",
    "capability_does_not_imply_authority": true,
