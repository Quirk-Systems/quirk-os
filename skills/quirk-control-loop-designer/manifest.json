  },
  "method": {
    "moves": ["read_signals", "model_controller", "simulate_policy", "emit_control_policy", "emit_admission_blockers"],
    "sequence": [
      "Resolve purpose, source authority, scope, and external grant before work begins.",
      "Inventory required inputs and preserve provenance or source references.",
      "Execute the smallest deterministic procedure that can satisfy the declared output.",
      "Evaluate positive, adversarial, regression, and authority conditions.",
      "Emit an attributable receipt and route improvements as Proposed Moves."
    ],
    "decision_points": [
      "Is the source and decision authority sufficient for this procedure?",
      "Would the next action exceed the declared authority ceiling or become irreversible?",
      "Is the evidence strong enough to emit the declared output rather than abstain?"
