    "self_escalation": false,
    "canon_promotion": false,
    "irreversible_write": false
  },
  "triggers": {
    "when_to_use": [
      "Use when the task requires design bounded feedback control with trustworthy sensors, explicit targets, reversible actuators, constraints, recovery, simulation, and human authority."
    ],
    "when_not_to_use": [
      "Do not use when source authority, purpose, or the external authority grant cannot be established.",
      "Do not use when a trigger collision with another skill remains unresolved."
    ],
    "routing_signals": [
      "feedback control",
      "threshold",
      "hysteresis",
      "actuator",
      "circuit breaker"
    ],
    "collision_behavior": "block"
  },
  "contract": {
    "inputs": [
      {"name": "controlled_object", "type": "string", "required": true},
      {"name": "signal_contract", "type": "object", "required": true},
      {"name": "authority_scope", "type": "object", "required": true}
    ],
    "outputs": [
      {"name": "control_policy", "type": "object", "required": true},
      {"name": "simulation_report", "type": "object", "required": true}
    ],
    "invariants": ["controller_cannot_rewrite_limits", "actuator_authority_independent", "safe_degraded_state_defined"],
