      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.5rem",
      "pill": "9999px"
    },
    "typography": {
      "fontFamily": {
        "sans": "'Inter', 'Segoe UI', system-ui, sans-serif",
        "mono": "'JetBrains Mono', 'SFMono-Regular', monospace"
      },
      "fontSize": {
        "sm": "0.875rem",
        "md": "1rem",
        "lg": "1.125rem",
        "xl": "1.5rem",
        "2xl": "2rem"
      },
      "lineHeight": {
        "tight": 1.2,
        "normal": 1.5,
        "relaxed": 1.7
      }
    }
  },
  "semantic": {
    "themes": {
      "light": {
        "surface": {
          "canvas": "#f8fafc",
          "elevated": "#ffffff",
          "muted": "#f1f5f9"
        },
        "text": {
          "primary": "#020617",
          "secondary": "#475569",
          "inverse": "#f8fafc"
        },
        "border": {
          "subtle": "#cbd5e1",
          "strong": "#475569"
        },
        "accent": {
          "primary": "#4338ca",
          "secondary": "#06b6d4",
          "interactive": "#6366f1"
        },
        "status": {
          "success": "#15803d",
          "warning": "#ca8a04",
          "warningForeground": "#854d0e",
          "danger": "#dc2626"
        }
      },
      "dark": {
        "surface": {
          "canvas": "#020617",
          "elevated": "#0f172a",
          "muted": "#1e293b"
        },
        "text": {
          "primary": "#f8fafc",
          "secondary": "#cbd5e1",
          "inverse": "#020617"
        },
        "border": {
          "subtle": "#334155",
          "strong": "#94a3b8"
        },
        "accent": {
          "primary": "#818cf8",
          "secondary": "#22d3ee",
          "interactive": "#6366f1"
        },
        "status": {
          "success": "#4ade80",
          "warning": "#facc15",
          "warningForeground": "#fde68a",
          "danger": "#f87171"
        }
      }
    }
