{
  "core": {
    "meta": {
      "name": "Quirk Core Tokens",
      "version": "1.0.0"
    },
    "color": {
      "indigo": {
        "50": "#eef2ff",
        "400": "#818cf8",
        "500": "#6366f1",
        "700": "#4338ca",
        "950": "#1e1b4b"
      },
      "cyan": {
        "400": "#22d3ee",
        "500": "#06b6d4"
      },
      "slate": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "300": "#cbd5e1",
        "600": "#475569",
        "800": "#1e293b",
        "950": "#020617"
      }
    },
    "spacing": {
      "0": "0rem",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "12": "3rem"
