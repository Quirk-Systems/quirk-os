  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "moderate": "220ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "guidelines": {
      "reducedMotion": "Provide non-essential motion alternatives and respect prefers-reduced-motion."
    }
  }
}
