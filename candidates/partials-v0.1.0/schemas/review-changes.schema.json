{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirk:partials-review-changes:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "before_request_digest",
    "after_request_digest",
    "before_captured_at",
    "after_captured_at",
    "context_changes",
    "rows",
    "counts",
    "authority",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "quirk.partials-review-changes/v1alpha1"
    },
    "status": {
      "const": "candidate"
    },
    "before_request_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "after_request_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "before_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "after_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "context_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "captured_at",
          "max_age_seconds"
        ]
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "change",
          "before",
          "after",
          "changed_fields",
          "before_count",
          "after_count",
          "claims_requiring_revalidation",
          "removed_holds",
          "added_holds",
          "proposed_repair"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "change": {
            "enum": [
              "unchanged",
              "added",
              "removed",
              "replaced",
              "changed"
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input_digest",
                  "disposition",
                  "reason",
                  "duplicate_source_ref"
                ],
                "properties": {
                  "input_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "disposition": {
                    "enum": [
                      "matched",
                      "quarantined",
                      "duplicate"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "expectation_matched",
                      "invalid_record",
                      "expectation_missing",
                      "subject_mismatch",
                      "stale_capture",
                      "future_capture",
                      "identity_conflict",
                      "exact_replay"
                    ]
                  },
                  "duplicate_source_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input_digest",
                  "disposition",
                  "reason",
                  "duplicate_source_ref"
                ],
                "properties": {
                  "input_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "disposition": {
                    "enum": [
                      "matched",
                      "quarantined",
                      "duplicate"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "expectation_matched",
                      "invalid_record",
                      "expectation_missing",
                      "subject_mismatch",
                      "stale_capture",
                      "future_capture",
                      "identity_conflict",
                      "exact_replay"
                    ]
                  },
                  "duplicate_source_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "changed_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "record",
                "record.id",
                "subject",
                "scope",
                "knowledge",
                "evidence",
                "work",
                "availability",
                "authority",
                "provenance",
                "revision",
                "supersedes_digest",
                "expectation",
                "max_count",
                "review_accounting",
                "max_age_seconds"
              ]
            }
          },
          "before_count": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_count": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "claims_requiring_revalidation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "removed_holds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "added_holds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "proposed_repair": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "action",
                  "target_ref",
                  "evidence_refs",
                  "acceptance_criteria",
                  "maximum_right",
                  "effect_execution_allowed",
                  "human_review_required"
                ],
                "properties": {
                  "status": {
                    "const": "candidate"
                  },
                  "action": {
                    "enum": [
                      "repair_native_input",
                      "account_for_removed_source",
                      "review_hold_removal",
                      "obtain_source_expectation",
                      "reconcile_identity",
                      "reinspect_source",
                      "review_policy_change",
                      "verify_recapture",
                      "revalidate_source_claims",
                      "review_added_source",
                      "review_record_change"
                    ]
                  },
                  "target_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "acceptance_criteria": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "maximum_right": {
                    "const": "propose"
                  },
                  "effect_execution_allowed": {
                    "const": false
                  },
                  "human_review_required": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "unchanged",
        "added",
        "removed",
        "replaced",
        "changed",
        "proposed_repairs"
      ],
      "properties": {
        "sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "replaced": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "proposed_repairs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_right",
        "effect_execution_allowed",
        "calendar_write_allowed",
        "canon_promotion_allowed",
        "graph_application_allowed",
        "training_allowed",
        "human_review_required",
        "upstream_hold_refs"
      ],
      "properties": {
        "maximum_right": {
          "const": "propose"
        },
        "effect_execution_allowed": {
          "const": false
        },
        "calendar_write_allowed": {
          "const": false
        },
        "canon_promotion_allowed": {
          "const": false
        },
        "graph_application_allowed": {
          "const": false
        },
        "training_allowed": {
          "const": false
        },
        "human_review_required": {
          "const": true
        },
        "upstream_hold_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ref",
        "transform_version",
        "output_digest",
        "observed_human_benefit",
        "human_review_minutes",
        "compute_cost",
        "limitations"
      ],
      "properties": {
        "capability_ref": {
          "const": "capability.partials-change-review/v0.1.0"
        },
        "transform_version": {
          "const": "0.1.0"
        },
        "output_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "observed_human_benefit": {
          "type": "null"
        },
        "human_review_minutes": {
          "type": "null"
        },
        "compute_cost": {
          "type": "null"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
