{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirk:partials-review-request:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "max_age_seconds",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "quirk.partials-review-request/v1alpha1"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "record",
          "max_count",
          "expectation"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record": {},
          "max_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expectation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "source_ref",
                  "observed_at"
                ],
                "properties": {
                  "subject": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "system",
                      "id",
                      "version",
                      "digest"
                    ],
                    "properties": {
                      "system": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    }
                  },
                  "source_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
