{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quirk://schemas/beauty/real-proof/0.1.0",
  "title": "QuirkBeautyTasteEngineRealProof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proofId": { "type": "string" },
    "domainBoundaryRef": { "const": "quirk.products.beauty" },
    "synthetic": { "const": false },
    "participantConsent": { "const": true },
    "purpose": { "type": "string" },
    "actorId": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "choice": { "$ref": "taste-choice.schema.json" },
    "preferenceEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "preference-evidence.schema.json" } },
    "recommendation": { "$ref": "recommendation.schema.json" },
    "realWorldOutcome": { "$ref": "outcome-observation.schema.json" },
    "graphUpdateProposal": { "$ref": "graph-update-proposal.schema.json" },
    "humanDecision": { "$ref": "graph-update-decision.schema.json" },
    "graphUpdateReceipt": { "$ref": "preference-graph-receipt.schema.json" },
    "artifactDigests": { "type": "object", "minProperties": 7, "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "operatorAttestation": { "type": "string", "minLength": 1 }
  },
  "required": ["proofId", "domainBoundaryRef", "synthetic", "participantConsent", "purpose", "actorId", "startedAt", "completedAt", "choice", "preferenceEvidence", "recommendation", "realWorldOutcome", "graphUpdateProposal", "humanDecision", "graphUpdateReceipt", "artifactDigests", "operatorAttestation"]
}
