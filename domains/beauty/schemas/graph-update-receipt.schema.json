{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "quirk://beauty/schemas/graph-update-receipt/0.1.1",
  "required": [
    "kind",
    "actorId",
    "purpose",
    "proposalId",
    "decisionId",
    "beforeRevision",
    "afterRevision",
    "appliedAt",
    "evidenceIds",
    "effect",
    "id",
    "actionDigest",
    "receiptWriter"
  ],
  "properties": {
    "kind": {
      "const": "PreferenceGraphUpdateReceipt"
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "proposalId": {
      "type": "string",
      "pattern": "^graph-update-proposal:"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^graph-update-decision:"
    },
    "beforeRevision": {
      "type": "integer",
      "minimum": 0
    },
    "afterRevision": {
      "type": "integer",
      "minimum": 1
    },
    "appliedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "effect": {
      "const": "bounded_preference_graph_update"
    },
    "id": {
      "type": "string",
      "pattern": "^receipt:"
    },
    "actionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "receiptWriter": {
      "type": "string",
      "minLength": 1
    }
  }
}
