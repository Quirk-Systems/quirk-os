{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "quirk://beauty/schemas/graph-update-decision/0.1.1",
  "required": [
    "id",
    "proposalId",
    "actorId",
    "purpose",
    "decision",
    "humanConfirmed",
    "reason",
    "corrections",
    "decidedAt",
    "expiresAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^graph-update-decision:"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^graph-update-proposal:"
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approve",
        "revise",
        "reject"
      ]
    },
    "humanConfirmed": {
      "const": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "setStrength",
          "evidenceIds"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^[^=]+=.+"
          },
          "setStrength": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
