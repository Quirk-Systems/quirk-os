{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "quirk://beauty/schemas/recommendation/0.1.1",
  "required": [
    "id",
    "actorId",
    "purpose",
    "optionId",
    "score",
    "confidence",
    "evidenceIds",
    "factors",
    "insufficientEvidence",
    "status",
    "generatedAt",
    "expiresAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^recommendation:"
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "optionId": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence:"
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "contribution",
          "evidenceIds"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^[^=]+=.+"
          },
          "contribution": {
            "type": "number"
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^evidence:"
            }
          }
        }
      }
    },
    "insufficientEvidence": {
      "type": "boolean"
    },
    "status": {
      "const": "candidate"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
