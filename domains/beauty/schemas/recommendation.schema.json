{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quirk://schemas/beauty/recommendation/0.1.0",
  "title": "Recommendation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "actorId": { "type": "string" },
    "purpose": { "type": "string" },
    "optionId": { "type": "string" },
    "score": { "type": "number" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature": { "type": "string" },
          "contribution": { "type": "number" },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "required": ["feature", "contribution", "evidenceIds"]
      }
    },
    "insufficientEvidence": { "type": "boolean" },
    "status": { "const": "candidate" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "actorId", "purpose", "optionId", "score", "confidence", "evidenceIds", "factors", "insufficientEvidence", "status", "generatedAt", "expiresAt"]
}
