{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/plugin-surface-observation.v0.1.schema.json",
  "title": "Plugin surface observation candidate",
  "type": "object",
  "required": ["api_version", "kind", "identity", "surface", "rights", "effects", "authority", "contradictions", "observed_at", "fresh_until"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": "quirk.capability-harvest/v0.1"},
    "kind": {"const": "PluginSurfaceObservation"},
    "identity": {
      "type": "object",
      "required": ["plugin_id", "package_id", "declared_version", "resolved_version"],
      "additionalProperties": false,
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1},
        "package_id": {"type": "string", "minLength": 1},
        "declared_version": {"type": "string", "minLength": 1},
        "resolved_version": {"type": "string", "minLength": 1}
      }
    },
    "surface": {
      "type": "object",
      "required": ["type", "id", "relative_path", "sha256", "installed", "exposed", "callable"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["manifest", "skill", "tool", "app", "mcp", "documentation", "runtime"]},
        "id": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "installed": {"enum": ["observed", "not_observed"]},
        "exposed": {"enum": ["observed", "not_observed", "unknown"]},
        "callable": {"enum": ["registered", "observed_success", "observed_failure", "not_registered", "unknown"]}
      }
    },
    "rights": {
      "type": "object", "required": ["status", "license_ref"], "additionalProperties": false,
      "properties": {"status": {"enum": ["clear", "restricted", "unclear"]}, "license_ref": {"type": ["string", "null"]}}
    },
    "effects": {
      "type": "object", "required": ["documented", "observed"], "additionalProperties": false,
      "properties": {
        "documented": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "observed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "authority": {
      "type": "object", "required": ["required", "granted"], "additionalProperties": false,
      "properties": {"required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "granted": {"const": false}}
    },
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": "string", "format": "date-time"}
  }
}
