{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/ledger-transition.schema.json",
  "title": "Quirk Ledger Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "subject",
    "operation",
    "risk_class",
    "status",
    "proposer",
    "purpose",
    "authority",
    "provenance",
    "evidence_refs",
    "reversibility",
    "occurred_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^qlt_[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "const": "ledger.transition.v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_type", "expected_version"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "object_type": {"type": "string", "minLength": 1},
        "expected_version": {"type": ["integer", "string"], "minLength": 1}
      }
    },
    "operation": {"type": "string", "minLength": 1},
    "patch": {"type": ["object", "array"]},
    "risk_class": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "evaluating",
        "approved",
        "rejected",
        "deferred",
        "applying",
        "applied",
        "verified",
        "operative",
        "challenged",
        "superseded",
        "revoked",
        "expired",
        "poisoned",
        "forgotten"
      ]
    },
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "actor_type": {
          "type": "string",
          "enum": ["human", "agent", "service", "policy"]
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prohibited": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "human_explicit",
            "policy_delegated",
            "mutual",
            "system_deterministic",
            "emergency",
            "waiver"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["required", "requested", "authorized", "denied", "expired", "revoked"]
        },
        "authority_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_refs"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "parent_transition_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["trivial", "reversible", "compensatable", "irreversible"]
        },
        "rollback_ref": {"type": "string", "minLength": 1}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"risk_class": {"enum": ["L4", "L5"]}},
        "required": ["risk_class"]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "mode": {"enum": ["human_explicit", "mutual", "emergency", "waiver"]}
            }
          }
        }
      }
    }
  ]
}
