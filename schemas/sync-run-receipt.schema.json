{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.dev/schemas/sync-run-receipt.schema.json",
  "title": "Quirk Sync Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "idempotency_key",
    "run_type",
    "status",
    "started_at",
    "input_refs",
    "output_refs",
    "evidence_refs"
  ],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^receipt\\.[a-z0-9._-]+$"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 255},
    "run_type": {"enum": ["discover", "pull", "push", "reconcile", "project", "validate", "backfill", "rebuild"]},
    "status": {"enum": ["planned", "running", "succeeded", "failed", "blocked", "cancelled"]},
    "actor_ref": {"type": ["string", "null"]},
    "authority_ref": {"type": ["string", "null"]},
    "agent_ref": {"type": ["string", "null"]},
    "skill_ref": {"type": ["string", "null"]},
    "manifest_version": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "input_refs": {"type": "array", "items": {"type": "string"}},
    "output_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}
    },
    "error": {"type": ["object", "null"]},
    "proposed_move_ref": {"type": ["string", "null"]},
    "content_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"required": ["completed_at"]}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"required": ["completed_at", "error"]}
    }
  ]
}
