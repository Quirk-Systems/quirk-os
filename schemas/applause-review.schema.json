{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/applause-review.schema.json",
  "title": "Applause Review Candidate Contract",
  "x-quirk-status": "candidate",
  "x-quirk-semantic-authority": false,
  "x-quirk-runtime-authority": false,
  "x-quirk-canon-effect": "none",
  "anyOf": [
    {"$ref": "#/$defs/review_request"},
    {"$ref": "#/$defs/applause_review"}
  ],
  "$defs": {
    "review_request": {"type": "object"},
    "applause_review": {"type": "object"}
  }
}
