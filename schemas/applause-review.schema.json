{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/applause-review.schema.json",
  "title": "Applause Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "candidate_id",
    "case_id",
    "claim",
    "signal",
    "claim_state",
    "signal_state",
    "evidence_sufficiency",
    "causal_support",
    "contradiction_state",
    "guardrail_state",
    "version_binding",
    "freshness_state",
    "commitment_risk",
    "verdict",
    "required_codes",
    "withheld_claims",
    "missing_proof",
    "reversible_next_move",
    "evidence_refs",
    "warnings",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "applause-review.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "signal": {"type": "string", "minLength": 1},
    "claim_state": {"type": "string", "minLength": 1},
    "signal_state": {"type": "string", "minLength": 1},
    "evidence_sufficiency": {"type": "string", "minLength": 1},
    "causal_support": {"type": "string", "minLength": 1},
    "contradiction_state": {"type": "string", "minLength": 1},
    "guardrail_state": {"type": "string", "minLength": 1},
    "version_binding": {"type": "string", "minLength": 1},
    "freshness_state": {"type": "string", "minLength": 1},
    "commitment_risk": {"type": "string", "minLength": 1},
    "verdict": {
      "enum": [
        "SIGNAL_ONLY",
        "SUPPORTED_DIAGNOSIS",
        "VERIFIED_SUCCESS",
        "FALSE_POSITIVE",
        "UNRESOLVED",
        "EVIDENCE_INTEGRITY_FAILURE"
      ]
    },
    "required_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "withheld_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_proof": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reversible_next_move": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "none"}
  }
}
