{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://quirk.systems/schemas/card-instance.schema.json","title":"Quirk Card Instance","type":"object","additionalProperties":false,"required":["instance_id","card_id","holder_ref","access_kind","state","acquired_at","authority_effect","ownership_claim"],"properties":{"instance_id":{"type":"string","pattern":"^card-instance\\.[a-z0-9._-]+$"},"card_id":{"type":"string","pattern":"^card\\.[a-z0-9_-]+\\.[a-z0-9._-]+$"},"holder_ref":{"type":"string"},"access_kind":{"enum":["owned","subscription","organization","trial","borrowed","public","granted"]},"state":{"enum":["accessible","in_hand","expired","revoked","transferred"]},"acquired_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"entitlement_ref":{"type":["string","null"]},"ownership_claim":{"enum":["owned","not_owned"]},"authority_effect":{"const":"none"},"edition":{"type":["string","null"]},"provenance_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"metadata":{"type":"object"}},"allOf":[{"if":{"properties":{"access_kind":{"const":"owned"}},"required":["access_kind"]},"then":{"properties":{"ownership_claim":{"const":"owned"}}}},{"if":{"properties":{"access_kind":{"enum":["subscription","organization","trial","borrowed","public"]}},"required":["access_kind"]},"then":{"properties":{"ownership_claim":{"const":"not_owned"}}}},{"if":{"properties":{"access_kind":{"enum":["subscription","trial","borrowed"]}},"required":["access_kind"]},"then":{"required":["expires_at"]}}]}