{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.dev/schemas/manifest-approval-attestation.schema.json",
  "title": "Explicit human manifest approval, external to runtime-manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "pr_number",
    "head_sha",
    "base_sha",
    "manifest_path",
    "manifest_key",
    "manifest_version",
    "hash_profile",
    "content_hash",
    "requested_by",
    "action",
    "from_status",
    "to_status",
    "requested_status",
    "environment",
    "authority_ceiling",
    "allowed_actions",
    "object_scope",
    "evaluation_ref",
    "evidence_refs",
    "valid_from",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "manifest-approval-attestation.v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_key": {
      "type": "string",
      "pattern": "^(agent|skill|capability|orchestrator)\\.[a-z0-9._-]+$"
    },
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "hash_profile": {
      "const": "runtime-manifest-content.v1"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^(human|agent|service|system)\\.[a-z0-9._-]+$"
    },
    "action": {
      "const": "activate_manifest"
    },
    "from_status": {
      "enum": [
        "candidate",
        "paused",
        "active"
      ]
    },
    "to_status": {
      "const": "active"
    },
    "requested_status": {
      "const": "active"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "authority_ceiling": {
      "enum": [
        "observe",
        "infer",
        "propose",
        "execute_reversible",
        "enforce_invariant",
        "execute_protected"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "object_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
