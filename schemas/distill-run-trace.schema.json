{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/distill-run-trace.schema.json",
  "title": "Quirk Distill Run Trace",
  "description": "What actually happened inside one finished skill run, as the post-run distill trigger consumes it. A trace is evidence about a run; it carries no authority of its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "receipt_id",
    "skill_id",
    "skill_version",
    "task_class",
    "routing_signals_observed",
    "moves",
    "stop_conditions_hit"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "pattern": "^trace\\.[a-z0-9._-]+$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt\\.[a-z0-9._-]+$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^quirk-[a-z0-9-]+$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "task_class": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "routing_signals_observed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "move",
          "outcome",
          "evidence_ref"
        ],
        "properties": {
          "move": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "outcome": {
            "enum": [
              "succeeded",
              "failed",
              "skipped"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stop_conditions_hit": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    }
  }
}
