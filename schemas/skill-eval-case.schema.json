{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.quirk.systems/skill-eval-case.schema.json","title":"Quirk Skill Eval Case","type":"object","additionalProperties":false,"required":["id","skill_id","skill_version","kind","scenario","input","expected"],"properties":{"id":{"type":"string","pattern":"^QSK-[0-9]{3}$"},"skill_id":{"type":"string","pattern":"^quirk-[a-z0-9-]+$"},"skill_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"kind":{"enum":["positive","adversarial","regression","authority"]},"scenario":{"type":"string","pattern":"^[a-z0-9_]+$"},"input":{"type":"object"},"expected":{"type":"object","additionalProperties":false,"required":["result","action","blocked","required_codes","prohibited_codes"],"properties":{"result":{"enum":["pass","stop","abstain","propose"]},"action":{"type":"string","pattern":"^[a-z0-9_]+$"},"blocked":{"type":"boolean"},"required_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z0-9_]+$"}},"prohibited_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z0-9_]+$"}}}}}}
