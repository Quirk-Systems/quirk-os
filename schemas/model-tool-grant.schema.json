{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/model-tool-grant.schema.json",
  "title": "Quirk Model Tool Projection Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "skill_id",
    "skill_version",
    "skill_manifest_sha256",
    "decision",
    "admission_ref",
    "requested_by",
    "approved_by",
    "issued_at",
    "expires_at",
    "authority_ceiling",
    "allowed_actions",
    "purpose",
    "runtime_manifest_sha256",
    "tool_registry_sha256",
    "runtime_admission_ref",
    "object_scope",
    "authorities"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^grant\\.[a-z0-9._-]+$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^quirk-[a-z0-9-]+$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "skill_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "const": "approved"
    },
    "admission_ref": {
      "type": "string",
      "minLength": 8
    },
    "requested_by": {
      "type": "string",
      "minLength": 2
    },
    "approved_by": {
      "type": "string",
      "minLength": 2
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_ceiling": {
      "enum": [
        "observe",
        "infer",
        "propose",
        "execute_bounded"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 12
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_admission_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "authorities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
