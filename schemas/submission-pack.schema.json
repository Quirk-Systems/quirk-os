{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/submission-pack.schema.json",
  "title": "Skills Submission Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_for",
    "rule_snapshot",
    "package",
    "public_copy",
    "evidence_notes",
    "independent_verdict",
    "review_cases",
    "missing_inputs",
    "contradictions",
    "version_drift",
    "owner_actions",
    "unperformed_actions",
    "attestations"
  ],
  "properties": {
    "schema_version": {"const": "skill-submission-pack.v1"},
    "status": {
      "enum": [
        "PARTIAL_MISSING_INPUT",
        "BLOCKED_INPUT_CONFLICT",
        "BLOCKED_UNVERIFIED_EVIDENCE"
      ]
    },
    "generated_for": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue", "generated_on"],
      "properties": {
        "repository": {"const": "Quirk-Systems/quirk-os"},
        "issue": {"const": 60},
        "generated_on": {"type": "string", "format": "date"}
      }
    },
    "rule_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_on",
        "official_sources",
        "verified",
        "packaged_rules_ref",
        "conflict_assessment"
      ],
      "properties": {
        "checked_on": {"type": "string", "format": "date"},
        "official_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "verified": {"type": "boolean"},
        "packaged_rules_ref": {"type": ["string", "null"], "minLength": 1},
        "conflict_assessment": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidate", "submitted_package", "publisher", "support_and_privacy"],
      "properties": {
        "source_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "version",
            "source_blob_sha1",
            "manifest_sha256"
          ],
          "properties": {
            "id": {"type": "string", "pattern": "^quirk-[a-z0-9-]+$"},
            "title": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "source_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "manifest_sha256": {"$ref": "#/$defs/nullableSha256"}
          }
        },
        "submitted_package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_name",
            "version",
            "sha256",
            "classification",
            "contains_mcp",
            "requires_authentication",
            "uses_live_data",
            "performs_external_actions",
            "capability_allowlist"
          ],
          "properties": {
            "public_name": {"type": ["string", "null"], "minLength": 1},
            "version": {"type": ["string", "null"], "minLength": 1},
            "sha256": {"$ref": "#/$defs/nullableSha256"},
            "classification": {"type": ["string", "null"], "enum": ["skills-only", null]},
            "contains_mcp": {"type": ["boolean", "null"]},
            "requires_authentication": {"type": ["boolean", "null"]},
            "uses_live_data": {"type": ["boolean", "null"]},
            "performs_external_actions": {"type": ["boolean", "null"]},
            "capability_allowlist": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "website"],
          "properties": {
            "name": {"type": ["string", "null"], "minLength": 1},
            "website": {"type": ["string", "null"], "format": "uri"}
          }
        },
        "support_and_privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["support_url", "privacy_policy_url", "data_handling_claim"],
          "properties": {
            "support_url": {"type": ["string", "null"], "format": "uri"},
            "privacy_policy_url": {"type": ["string", "null"], "format": "uri"},
            "data_handling_claim": {"type": ["string", "null"], "minLength": 1}
          }
        }
      }
    },
    "public_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listing", "supported_capabilities", "starter_prompts", "release_notes"],
      "properties": {
        "listing": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "short_description", "description"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "short_description": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "supported_capabilities": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "starter_prompts": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "release_notes": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "evidence_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_note", "ledger"],
      "properties": {
        "scope_note": {"type": "string", "minLength": 1},
        "ledger": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ledgerEntry"}
        }
      }
    },
    "independent_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reference"],
      "properties": {
        "value": {"type": ["string", "null"], "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "review_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/reviewCase"}
        },
        "negative": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/reviewCase"}
        }
      }
    },
    "missing_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "contradictions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "version_drift": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "owner_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unperformed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "portal_scan",
          "portal_upload",
          "submission",
          "review",
          "attestation",
          "publication",
          "tag",
          "merge",
          "deployment"
        ]
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portal_operations_performed",
        "openai_review_or_approval_claimed",
        "product_verdict_upgraded",
        "source_tests_used_as_submitted_package_evidence"
      ],
      "properties": {
        "portal_operations_performed": {"const": false},
        "openai_review_or_approval_claimed": {"const": false},
        "product_verdict_upgraded": {"const": false},
        "source_tests_used_as_submitted_package_evidence": {"const": false}
      }
    }
  },
  "$defs": {
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "claim",
        "submitted_package_sha256",
        "evidence_refs"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "classification": {
          "enum": [
            "CONFIRMED_PRODUCT_FACT",
            "PASSED_TEST_EVIDENCE",
            "PROPOSED_OR_UNVERIFIED",
            "MISSING",
            "CONTRADICTION"
          ]
        },
        "claim": {"type": "string", "minLength": 1},
        "submitted_package_sha256": {"$ref": "#/$defs/nullableSha256"},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "expected_behavior",
        "package_sha256",
        "evidence_refs"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
