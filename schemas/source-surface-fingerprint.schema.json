{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/source-surface-fingerprint.v0.1.schema.json",
  "title": "Content-addressed source surface fingerprint",
  "type": "object",
  "required": ["api_version", "kind", "identity", "surface", "observation", "rights", "content", "status", "record_sha256"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": "quirk.capability-harvest/v0.1"}, "kind": {"const": "SourceSurfaceFingerprint"},
    "identity": {"type": "object", "required": ["provider", "package", "version"], "additionalProperties": false, "properties": {"provider": {"type": "string", "minLength": 1}, "package": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "surface": {"type": "object", "required": ["kind", "name", "state", "location", "effect_classes"], "additionalProperties": false, "properties": {"kind": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "state": {"enum": ["installed", "discoverable", "registered_callable", "runtime_observed", "documented", "unavailable"]}, "location": {"type": "string", "minLength": 1}, "effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "observation": {"type": "object", "required": ["observed_at", "fresh_until", "source_type", "capture_ref"], "additionalProperties": false, "properties": {"observed_at": {"type": "string", "format": "date-time"}, "fresh_until": {"type": "string", "format": "date-time"}, "source_type": {"type": "string", "minLength": 1}, "capture_ref": {"type": "string", "pattern": "^(quirk:[a-z][a-z0-9_.-]{2,127}|sha256:[a-f0-9]{64})$"}}},
    "rights": {"enum": ["quirk_owned", "open_license_verified", "reference_only", "proprietary", "unknown"]},
    "content": {"type": "object", "required": ["sha256", "byte_length"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "byte_length": {"type": "integer", "minimum": 0}}},
    "status": {"enum": ["candidate", "quarantined"]}, "record_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
