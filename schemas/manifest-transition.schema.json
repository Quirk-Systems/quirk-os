{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.dev/schemas/manifest-transition.schema.json",
  "title": "Quirk Manifest Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "manifest_key",
    "manifest_version",
    "from_status",
    "to_status",
    "requested_by",
    "approved_by",
    "decision_ref",
    "authority_grant_ref",
    "evaluated_content_hash",
    "occurred_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "manifest-transition.v1"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^transition\\.[a-z0-9._-]+$"
    },
    "manifest_key": {
      "type": "string",
      "pattern": "^(agent|skill|capability|orchestrator)\\.[a-z0-9._-]+$"
    },
    "manifest_version": {
      "type": "string"
    },
    "from_status": {
      "enum": [
        "candidate",
        "active",
        "paused",
        "superseded",
        "revoked"
      ]
    },
    "to_status": {
      "enum": [
        "candidate",
        "active",
        "paused",
        "superseded",
        "revoked"
      ]
    },
    "requested_by": {
      "type": "string",
      "pattern": "^(human|agent|service|system)\\.[a-z0-9._-]+$"
    },
    "approved_by": {
      "type": "string",
      "pattern": "^(human|agent|service|system)\\.[a-z0-9._-]+$"
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_grant_ref": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
