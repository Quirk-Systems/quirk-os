{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/tool-registry.schema.json",
  "title": "Quirk Tool Registry",
  "description": "Version-pinned tool action contracts. A runtime manifest may expose only actions resolved from this registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": "tool-registry.v1"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "canonical_name", "title", "actions"],
      "properties": {
        "ref": {"type": "string", "pattern": "^tool\\.[a-z0-9._-]+@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "canonical_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 3},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "parameter_schema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string", "minLength": 8},
        "parameter_schema": {
          "type": "object",
          "required": ["type", "properties", "additionalProperties"],
          "properties": {
            "type": {"const": "object"},
            "properties": {"type": "object"},
            "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "additionalProperties": {"const": false}
          }
        }
      }
    }
  }
}
