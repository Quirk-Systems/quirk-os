{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/model-tool-request-receipt.schema.json",
  "title": "Quirk Model Tool Request Receipt",
  "description": "Append-only measurement receipt for one serialized model request. Unknown is recorded as null, never estimated as fact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "request_sha256", "serialized_at", "emitted_tool_names", "measurement_state", "metrics", "immutable"],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^receipt\\.[a-z0-9._-]+$"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "serialized_at": {"type": "string", "format": "date-time"},
    "emitted_tool_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*__[a-z][a-z0-9_]*$"}},
    "measurement_state": {"enum": ["not_observed", "partial", "observed"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cash_cost_usd", "latency_ms", "human_effort_minutes", "updater_upkeep_minutes"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cash_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "human_effort_minutes": {"type": ["number", "null"], "minimum": 0},
        "updater_upkeep_minutes": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "immutable": {"const": true}
  }
}
