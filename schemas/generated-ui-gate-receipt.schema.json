{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/generated-ui-gate-receipt.schema.json",
  "title": "Quirk Generated UI Gate Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "plan_id",
    "status",
    "reason_codes",
    "component_refs",
    "semantic_fallback_ref",
    "runtime_authorized",
    "deployment_authorized",
    "manual_evidence_summary",
    "evaluated_at"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt\\.generated-ui\\.[a-z0-9._-]+$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^generated-ui\\.plan\\.[a-z0-9._-]+$"
    },
    "status": {
      "enum": [
        "rejected",
        "blocked_manual",
        "candidate_evidence_complete"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACCESSIBILITY_MACHINE_CHECK_FAILED",
          "AUTHORITY_EXPANSION_REQUESTED",
          "CANDIDATE_EVIDENCE_COMPLETE",
          "COMPONENT_HASH_UNVERIFIABLE",
          "COMPONENT_MANIFEST_INACCESSIBLE",
          "COMPONENT_MANIFEST_MISSING",
          "COMPONENT_MANIFEST_STALE",
          "COMPONENT_VERSION_INVALID",
          "GENERATED_UI_PLAN_MISSING",
          "MANUAL_EVIDENCE_MISSING",
          "RECONSTRUCTION_INPUTS_MISSING",
          "SEMANTIC_FALLBACK_MISSING"
        ]
      }
    },
    "component_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^component\\.[a-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "semantic_fallback_ref": {
      "type": "string",
      "minLength": 1
    },
    "runtime_authorized": {
      "const": false
    },
    "deployment_authorized": {
      "const": false
    },
    "manual_evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard",
        "focus_order_visibility",
        "screen_reader_semantics",
        "reflow_zoom",
        "contrast",
        "reduced_motion",
        "errors",
        "status_announcements"
      ],
      "properties": {
        "keyboard": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "focus_order_visibility": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "screen_reader_semantics": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "reflow_zoom": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "contrast": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "reduced_motion": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "errors": {
          "enum": [
            "provided",
            "missing"
          ]
        },
        "status_announcements": {
          "enum": [
            "provided",
            "missing"
          ]
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
