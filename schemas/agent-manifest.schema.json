{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.dev/schemas/agent-manifest.schema.json",
  "title": "Quirk Agent Manifest v1alpha1",
  "description": "Candidate contract for agents/<slug>/agent.yaml. Binding skills, tools, or credentials never implies admission or authority. Status, version, ceiling, domain, routing, and rights-review vocabularies are reused from runtime-manifest.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "purpose",
    "authority",
    "skills",
    "trigger_contract",
    "tools",
    "inputs",
    "outputs",
    "stop_conditions",
    "receipt_required"
  ],
  "properties": {
    "api_version": {
      "const": "quirk.dev/agent/v1alpha1"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^agent\\.[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "$ref": "runtime-manifest.schema.json#/properties/version"
        },
        "status": {
          "$ref": "runtime-manifest.schema.json#/properties/status"
        },
        "title": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 40
    },
    "domains": {
      "$ref": "runtime-manifest.schema.json#/properties/domains"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ceiling",
        "capability_does_not_imply_authority",
        "admission_policy_ref",
        "prohibited"
      ],
      "properties": {
        "ceiling": {
          "$ref": "#/$defs/ceiling"
        },
        "capability_does_not_imply_authority": {
          "const": true
        },
        "admission_policy_ref": {
          "const": "policies/manifest-admission-policy.yaml"
        },
        "prohibited": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "allOf": [
            {
              "contains": {
                "const": "activate_manifest"
              }
            },
            {
              "contains": {
                "const": "promote_canon"
              }
            },
            {
              "contains": {
                "const": "expand_authority"
              }
            },
            {
              "contains": {
                "const": "merge_pull_request"
              }
            },
            {
              "contains": {
                "const": "deploy_production"
              }
            }
          ]
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^skill\\.quirk-[a-z0-9-]+$"
      }
    },
    "trigger_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_policy",
        "collision_behavior",
        "evidence_refs"
      ],
      "properties": {
        "routing_policy": {
          "$ref": "runtime-manifest.schema.json#/properties/trigger_contract/properties/routing_policy"
        },
        "collision_behavior": {
          "const": "block"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed"
        ],
        "properties": {
          "allowed": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "schema_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "deployment": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "state": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/schema_binding"
    },
    "outputs": {
      "$ref": "#/$defs/schema_binding"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "receipt_required": {
      "const": true
    },
    "admission": {
      "$ref": "#/$defs/admission"
    },
    "rights_review": {
      "$ref": "runtime-manifest.schema.json#/properties/rights_review"
    }
  },
  "$defs": {
    "ceiling": {
      "$ref": "runtime-manifest.schema.json#/properties/authority_ceiling"
    },
    "schema_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "decision_ref",
        "authority_grant_ref",
        "granted_ceiling",
        "requested_by",
        "approved_by",
        "evaluated_content_hash",
        "transition_ref",
        "decided_at",
        "evidence_refs"
      ],
      "properties": {
        "decision": {
          "const": "approved"
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "authority_grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "granted_ceiling": {
          "$ref": "#/$defs/ceiling"
        },
        "requested_by": {
          "type": "string",
          "pattern": "^(human|agent|service|system)\\.[a-z0-9._-]+$"
        },
        "approved_by": {
          "type": "string",
          "pattern": "^(human|agent|service|system)\\.[a-z0-9._-]+$"
        },
        "evaluated_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transition_ref": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "required": [
          "admission"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "domains": {
            "contains": {
              "const": "data_productization"
            }
          }
        },
        "required": [
          "domains"
        ]
      },
      "then": {
        "required": [
          "rights_review"
        ],
        "properties": {
          "rights_review": {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "approved"
              },
              "license_verified": {
                "const": true
              },
              "privacy_review": {
                "const": "approved"
              },
              "provenance_complete": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
