{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/skill-run-receipt.v2.schema.json",
  "title": "Quirk Skill Run Receipt v2 \u2014 unverified declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "skill_id",
    "skill_version",
    "skill_manifest_sha256",
    "grant_id",
    "status",
    "started_at",
    "finished_at",
    "input_refs",
    "output_refs",
    "evidence_refs",
    "finding_codes",
    "proposed_mutations",
    "authority_ceiling_observed",
    "no_authority_escalation",
    "immutable",
    "schema_version",
    "evidence_status",
    "authority_ceiling_declared",
    "limitations"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt\\.[a-z0-9._-]+$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^quirk-[a-z0-9-]+$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "skill_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^grant\\.[a-z0-9._-]+$"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "abstained",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finding_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "proposed_mutations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_ceiling_observed": {
      "type": "null"
    },
    "no_authority_escalation": {
      "type": "null"
    },
    "immutable": {
      "type": "null"
    },
    "supersedes_receipt_id": {
      "type": "string",
      "pattern": "^receipt\\.[a-z0-9._-]+$"
    },
    "schema_version": {
      "const": "skill-run-receipt/v2"
    },
    "evidence_status": {
      "const": "unverified"
    },
    "authority_ceiling_declared": {
      "enum": [
        "observe",
        "infer",
        "propose",
        "execute_bounded"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "description": "Helper output records declarations and references, not observed effects. Historical v1 remains unchanged and is not observed evidence."
}
