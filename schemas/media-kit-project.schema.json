{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirk.systems/schemas/media-kit-project.schema.json",
  "title": "Quirk Media Kit Project (candidate only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "purpose",
    "owner",
    "status",
    "authority",
    "sources",
    "derivatives",
    "selection"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "media-kit-project.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^qmk_[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "status": {
      "type": "string",
      "const": "candidate"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ceiling",
        "publish_allowed",
        "graph_application_allowed",
        "training_allowed",
        "canon_promotion_allowed"
      ],
      "properties": {
        "ceiling": {
          "type": "string",
          "const": "candidate"
        },
        "publish_allowed": {
          "type": "boolean",
          "const": false
        },
        "graph_application_allowed": {
          "type": "boolean",
          "const": false
        },
        "training_allowed": {
          "type": "boolean",
          "const": false
        },
        "canon_promotion_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "object_ref",
          "version",
          "receipt_ref",
          "sha256",
          "source_status",
          "rights_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src_[A-Za-z0-9_-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "object_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "receipt_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_status": {
            "type": "string",
            "enum": [
              "candidate",
              "unverified",
              "canonical"
            ]
          },
          "rights_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "derivatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "source_id",
          "metadata"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "metadata": {
            "$ref": "media-derivative.schema.json"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivative_id",
        "rationale",
        "completion_condition",
        "actor",
        "signature_status"
      ],
      "properties": {
        "derivative_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "completion_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "type": {
              "type": "string",
              "enum": [
                "human",
                "agent"
              ]
            }
          }
        },
        "signature_status": {
          "type": "string",
          "const": "unsigned"
        }
      }
    }
  }
}
